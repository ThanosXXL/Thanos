{
  "name": "fotonetz",
  "version": "1.0.0",
  "description": "FotoNetz – Desktop-Dashboard für den Fotografen-Alltag: Aufträge, Aufgaben, Bearbeitungsstatus und Referenzen verwalten",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.fotonetz.dashboard",
    "productName": "FotoNetz",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
