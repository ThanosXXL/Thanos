{
  "name": "baustelle-tagesreport",
  "version": "1.0.0",
  "description": "Eigenständige Desktop-App für den Baustelle-Tagesreport (Tagesreport, Status, Bestellstatus, Screenshots)",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.2",
    "@capacitor/preferences": "^8.0.1"
  },
  "overrides": {
    "@electron/get": "^5.1.0"
  },
  "build": {
    "appId": "com.baustelle.tagesreport",
    "productName": "Baustelle Tagesreport",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "artifactName": "BaustelleTagesreport-Windows-Setup.${ext}"
    },
    "mac": {
      "target": "dmg",
      "artifactName": "BaustelleTagesreport-macOS.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "artifactName": "BaustelleTagesreport-Linux.${ext}"
    }
  }
}
