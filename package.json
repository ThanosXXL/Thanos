{
  "name": "buchhaltung",
  "version": "1.1.0",
  "description": "Buchhaltung! - Desktop-Buchhaltungssoftware fuer bis zu vier Administratoren mit monatlicher Erfassung (Januar-Dezember) und automatischer Erinnerung",
  "main": "main.js",
  "author": "",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "build:web": "node scripts/sync-docs.js",
    "build:standalone": "node scripts/build-standalone.js"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.buchhaltung.app",
    "productName": "Buchhaltung!",
    "icon": "build/icon.png",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "Buchhaltung-Windows-Setup.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "artifactName": "Buchhaltung-macOS.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "artifactName": "Buchhaltung-Linux.${ext}"
    }
  }
}
