{
  "name": "inventar-dashboard",
  "version": "1.1.0",
  "description": "Desktop-Dashboard zur Geräteinventar-Verwaltung mit Foto- und Spracherkennung",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ThanosXXL/Thanos.git"
  },
  "scripts": {
    "start": "electron .",
    "start:demo": "electron . --demo",
    "build:demo-standalone": "node docs/build-standalone-demo.js",
    "build:handbook-pdfs": "electron docs/build-handbook-pdfs.js",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.inventar.dashboard",
    "productName": "Inventar - Dashboard",
    "files": [
      "main.js",
      "preload.js",
      "demo-data.js",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "artifactName": "InventarDashboard-Setup.${ext}"
    },
    "mac": {
      "target": "dmg",
      "artifactName": "InventarDashboard.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "artifactName": "InventarDashboard.${ext}"
    },
    "publish": [
      {
        "provider": "github"
      }
    ]
  }
}
