# Port, auf dem der Server lauscht
PORT=4400

# Pfad zur SQLite-Datenbankdatei
DATABASE_PATH=./data/licenses.sqlite

# Ed25519-Schlüsselpaar (mit "npm run generate-keys" erzeugen).
# PRIVATE_KEY bleibt geheim und darf nur hier auf dem Server liegen.
# PUBLIC_KEY wird fest in die SteuerWelt-App eingebaut (steuerwelt/license/public-key.js).
LICENSE_SERVER_PRIVATE_KEY_PATH=./keys/private.pem

# Geheimer Schlüssel, den nur das Admin-Skript (create-license.js) kennt,
# falls die Lizenzausstellung später auch per HTTP erlaubt werden soll.
# Aktuell ungenutzt (Lizenzen werden nur per CLI erzeugt) — für später vorbereitet.
ADMIN_TOKEN=change-me

# Wie lange ein Aktivierungszertifikat gültig ist, bevor die App sich erneut
# beim Server melden muss (Tage).
CERTIFICATE_VALIDITY_DAYS=30
