{
  "name": "my-route",
  "version": "1.0.0",
  "description": "My Route – Routenplaner nach Favoriten: gespeicherte Routen mit einem Klick erneut anfahren",
  "main": "main.js",
  "author": "IT-WORLD – IT Solutions",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.js",
    "test": "node --test tests/*.test.js",
    "build:web": "node scripts/build-web.js",
    "build:android-web": "node scripts/build-web.js",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "@capacitor/android": "^7.4.0",
    "@capacitor/app-launcher": "^7.0.0",
    "@capacitor/cli": "^7.4.0",
    "@capacitor/core": "^7.4.0"
  },
  "overrides": {
    "@electron/get": "^5.1.0"
  },
  "build": {
    "appId": "de.itworld.myroute",
    "productName": "My Route",
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "icon": "build/icon.png",
    "win": {
      "target": "nsis",
      "artifactName": "My-Route-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.navigation",
      "artifactName": "My-Route-${version}-${arch}.${ext}",
      "hardenedRuntime": true
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "artifactName": "My-Route-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/thanosxxl/thanos/releases/download/my-route-updates"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  }
}
