{
  "name": "inventar-dashboard-downloader",
  "version": "1.1.0",
  "description": "1-Klick-Downloader: lädt das Inventar - Dashboard automatisch auf den Desktop und installiert es",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ThanosXXL/Thanos.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.inventar.dashboard.downloader",
    "productName": "Inventar - Dashboard Downloader",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "artifactName": "InventarDashboard-Downloader.${ext}"
    },
    "mac": {
      "target": "dmg",
      "artifactName": "InventarDashboard-Downloader.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "artifactName": "InventarDashboard-Downloader.${ext}"
    },
    "publish": [
      {
        "provider": "github"
      }
    ]
  }
}
