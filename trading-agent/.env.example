# Copy this file to .env and fill in your own values. Never commit .env.

# --- Binance API credentials ---
# Testnet keys: generate at https://testnet.binance.vision (Log in with GitHub, no real funds).
# Live keys: generate at https://www.binance.com/en/my/settings/api-management (real funds at risk).
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Trading mode ---
# "paper"   -> no orders are sent anywhere; simulated fills against real-time prices (default, safest).
# "testnet" -> real order flow against Binance's public Spot Testnet (fake funds, real exchange behavior).
# "live"    -> real orders against Binance production, using real funds. Requires LIVE_CONFIRM below.
TRADING_MODE=paper

# Live mode is intentionally hard to switch on by accident. To actually place real-money
# orders you must set TRADING_MODE=live AND type the exact confirmation phrase below.
LIVE_CONFIRM=

# --- Market & strategy ---
SYMBOL=BTCUSDT
# Candle interval used to drive the strategy (Binance kline intervals: 1m,5m,15m,1h,4h,1d,...)
# Shorter interval + shorter MA periods = more crossovers = more trades per day.
# More trades is NOT the same as more profit: it also means more exposure to
# noise and (on live/testnet) more exchange fees. Tune deliberately.
INTERVAL=1m
FAST_MA_PERIOD=5
SLOW_MA_PERIOD=13

# --- Risk management (all required, no unsafe defaults) ---
# Max fraction of quote-asset balance risked on a single position, e.g. 0.01 = 1%.
# Kept small on purpose: more trades per day means more chances to lose the
# per-trade risk amount, so the per-trade risk is set lower than a low-frequency setup.
RISK_PER_TRADE_PCT=0.01
# Stop-loss distance from entry price, e.g. 0.006 = 0.6%. Tight, to cut losers fast.
STOP_LOSS_PCT=0.006
# Take-profit distance from entry price, e.g. 0.012 = 1.2% (2x the stop-loss distance).
TAKE_PROFIT_PCT=0.012
# Hard kill-switch: stop opening new positions once realized losses in a trading day
# exceed this fraction of the starting daily balance, e.g. 0.03 = 3%.
MAX_DAILY_LOSS_PCT=0.03
# Maximum number of concurrent open positions. The current agent trades a single
# SYMBOL with a single strategy, so more than 1 has no effect yet — running
# multiple symbols concurrently would mean running multiple agent instances,
# each with its own .env / risk budget.
MAX_OPEN_POSITIONS=1

# --- Paper trading ---
# Simulated starting balance (in quote currency, e.g. USDT) used only when TRADING_MODE=paper.
PAPER_STARTING_BALANCE=1000

# --- Dashboard ---
DASHBOARD_PORT=4173

# --- Live mode minimum balance ---
# Live mode refuses to start unless the account's quote-asset balance is at
# least this much. Not literally EUR unless your SYMBOL is EUR-quoted — treat
# it as "quote-asset units," e.g. 50 USDT as a practical stand-in for ~50 EUR.
MIN_LIVE_BALANCE=50

# --- Withdrawals ---
# This project never collects deposits or initiates bank transfers itself —
# fund and withdraw fiat directly through Binance's own app/website (it
# already supports card/SEPA deposits and SEPA/instant withdrawal to your own
# verified bank account). What's below is only for an optional CRYPTO
# withdrawal to an address you control, triggered manually, never automatic.
# Leave blank to disable the withdrawal feature entirely.
WITHDRAWAL_ASSET=
WITHDRAWAL_ADDRESS=
# Same style of safeguard as LIVE_CONFIRM: withdrawals require typing this
# exact phrase, since they move real funds off the exchange irreversibly.
WITHDRAWAL_CONFIRM_PHRASE=I_CONFIRM_THIS_WITHDRAWAL

# --- Withdrawal email notification (optional) ---
# Sent to NOTIFY_EMAIL after every withdrawal you trigger, using your own
# SMTP account, purely for your own bookkeeping/records. Leave SMTP_HOST
# blank to disable — a failed/missing email never blocks the withdrawal.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
