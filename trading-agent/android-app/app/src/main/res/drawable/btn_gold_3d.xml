<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="270"
                android:startColor="#3C3C3C"
                android:centerColor="#141414"
                android:endColor="#000000" />
            <stroke
                android:width="1dp"
                android:color="@color/gold_dark" />
        </shape>
    </item>
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="270"
                android:startColor="#48FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
