{
  "name": "praxis-dashboard",
  "version": "1.0.0",
  "description": "Desktop-Praxisverwaltung (Patientenakte, Journal, Rezepte, Termine) im Blau-Weiss-3D-Hochglanz-Stil",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.praxis.dashboard",
    "productName": "Praxis Dashboard",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
