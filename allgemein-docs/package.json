{
  "name": "allgemein-docs",
  "version": "1.0.0",
  "description": "Allgemein Docs – moderne Praxisverwaltung für Allgemeinmedizin: Patientenakte, Termine, Wartezimmer, Dokumente",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.allgemeindocs.app",
    "productName": "Allgemein Docs",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "mac": { "target": "dmg", "icon": "build/icon.png" },
    "linux": { "target": "AppImage", "icon": "build/icon.png" }
  }
}
