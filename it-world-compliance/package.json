{
  "name": "it-world-compliance-assistent",
  "version": "1.0.0",
  "description": "IT-WORLD Compliance-Assistent für KMU: NIS2, DSGVO und IT-Sicherheitsnachweise",
  "main": "main.js",
  "author": "IT-WORLD",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "overrides": {
    "@electron/get": "^5.1.0"
  },
  "build": {
    "appId": "com.itworld.compliance",
    "productName": "IT-WORLD Compliance-Assistent",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  }
}
